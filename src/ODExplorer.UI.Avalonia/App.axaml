<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ODExplorer.UI.Avalonia.Views"
             x:Class="ODExplorer.UI.Avalonia.App"
             RequestedThemeVariant="Dark">
             <!-- "Dark" matches the original dark-styled app; hardcoded dark surfaces
                  (nav bar, scanning overlay) rely on the dark theme's light foreground. -->

    <Application.DataTemplates>
        <views:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/od-explorer-icon-64.png"
                      ToolTipText="OD Explorer">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show OD Explorer" Click="OnTrayShow" />
                        <NativeMenuItem Header="Quit" Click="OnTrayQuit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>