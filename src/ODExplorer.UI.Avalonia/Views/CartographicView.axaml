<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ODExplorer.ViewModels.ViewVMs"
             xmlns:modelvms="using:ODExplorer.ViewModels.ModelVMs"
             xmlns:models="using:ODExplorer.Models"
             xmlns:conv="using:ODExplorer.UI.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="ODExplorer.UI.Avalonia.Views.CartographicView"
             x:DataType="vm:CartographicViewModel">
    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="StateVisible" />
        <conv:CountToBoolConverter x:Key="CountToBool" />
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">
        <!-- Body area -->
        <Grid Grid.Row="0" Margin="5">

            <!-- Unified layout: system header + body list + detail panel -->
            <Grid IsVisible="{Binding CurrentState, Converter={StaticResource StateVisible}, ConverterParameter={x:Static models:CartoViewState.DetailedExo}}"
                  RowDefinitions="Auto,Auto,Auto,*">

                <!-- Current system header -->
                <Border Grid.Row="0"
                        Background="#282828"
                        BorderBrush="#404040"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,6"
                        Margin="0,0,0,6"
                        IsVisible="{Binding CurrentSystem}">
                    <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding CurrentSystem.Name}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Content="Copy"
                                    Padding="6,2"
                                    Margin="6,0,0,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Copy system name to clipboard"
                                    Command="{Binding CopySystemName}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="Region" Foreground="#999999" FontSize="11" />
                                <TextBlock Text="{Binding CurrentSystem.Region}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Star" Foreground="#999999" FontSize="12" />
                                <TextBlock Text="{Binding CurrentSystem.StarClass}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Bodies" Foreground="#999999" FontSize="12" />
                                <TextBlock Text="{Binding CurrentSystem.BodyCount, StringFormat=N0}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Discovered" Foreground="#999999" FontSize="12" />
                                <TextBlock Text="{Binding CurrentSystem.DiscoveredBodiesCount, StringFormat=N0}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Estimated Value" Foreground="#999999" FontSize="12" />
                                <TextBlock Text="{Binding CurrentSystem.EstimatedValue}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding HasSpanshRoute}">
                            <TextBlock Text="Route target" Foreground="#CD9B1D" FontSize="12" />
                            <TextBlock Text="{Binding SpanshTargetSystem}" Foreground="#CD9B1D" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="-" Foreground="#CD9B1D" FontSize="12"
                                       IsVisible="{Binding IsInSpanshTargetSystem}" />
                            <TextBlock Text="{Binding SpanshTargetBodies}" Foreground="#CD9B1D" FontSize="12" FontWeight="SemiBold"
                                       IsVisible="{Binding IsInSpanshTargetSystem}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sort bar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="4,0,4,4">
    <TextBlock Text="Sort:" VerticalAlignment="Center" Foreground="#999999" FontSize="12" />
    <Button Content="Name" Padding="8,2" FontSize="11"
            Command="{Binding SetSortCategory}"
            CommandParameter="{x:Static models:BodySortCategory.Name}" />
    <Button Content="Value" Padding="8,2" FontSize="11"
                            Command="{Binding SetSortCategory}"
                            CommandParameter="{x:Static models:BodySortCategory.Value}" />
                    <Button Content="Bio" Padding="8,2" FontSize="11"
                            Command="{Binding SetSortCategory}"
                            CommandParameter="{x:Static models:BodySortCategory.BioSignals}" />
                    <Button Content="Geo" Padding="8,2" FontSize="11"
                            Command="{Binding SetSortCategory}"
                            CommandParameter="{x:Static models:BodySortCategory.GeoSignals}" />
                    <Button Content="Distance" Padding="8,2" FontSize="11"
                            Command="{Binding SetSortCategory}"
                            CommandParameter="{x:Static models:BodySortCategory.Distance}" />
                    <Button Content="{Binding SortDirectionGlyph}" Padding="6,2" FontSize="11"
                            ToolTip.Tip="Toggle ascending/descending"
                            Command="{Binding CycleSortDirection}" />
                    <CheckBox Content="Belts"
                              IsChecked="{Binding ShowBeltClusters}"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              FontSize="11" />
                </StackPanel>

                <!-- Bodies label -->
                <TextBlock Grid.Row="2"
                           Text="Bodies"
                           FontWeight="SemiBold"
                           Margin="4,0,0,4" />

                <!-- Body list + detail panel -->
                <Grid Grid.Row="3" ColumnDefinitions="2*,4,3*">
                    <!-- Tree body list -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CurrentSystemTree}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StarBodyGroup">
                                    <StackPanel Margin="0,0,4,8">
                                        <!-- Barycentre header -->
                                        <Border Background="#333333"
                                                BorderBrush="#505050"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,2"
                                                Cursor="Hand"
                                                Tapped="StarHeader_Tapped"
                                                IsVisible="{Binding IsBarycentre}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <TextBlock Text="{Binding ExpandGlyph}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           FontSize="11"
                                                           Foreground="#999999"
                                                           IsVisible="{Binding HasChildren}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="⊕" Foreground="#CD9B1D" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding BarycentreLabel}"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- Star header -->
                                        <Border Background="#333333"
                                                BorderBrush="#505050"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,2"
                                                Cursor="Hand"
                                                Tapped="StarHeader_Tapped"
                                                IsVisible="{Binding !IsBarycentre}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Text="{Binding ExpandGlyph}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           FontSize="11"
                                                           Foreground="#999999"
                                                           IsVisible="{Binding HasChildren}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="★" Foreground="#FFD700" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Star.Name}"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Star.BodyDescription}"
                                                               Foreground="#BBBBBB"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Star.DataValueString}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <!-- Child bodies -->
                                        <ItemsControl ItemsSource="{Binding Children}" Margin="12,0,0,0"
                                                      IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="modelvms:SystemBodyViewModel">
                                                    <Border Background="#282828"
                                                            BorderBrush="#404040"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8"
                                                            Margin="0,0,0,4"
                                                            Cursor="Hand"
                                                            Tapped="Body_Tapped">
                                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DataValueString}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"
                                                                       Margin="8,0,0,0" />
                                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding BodyDescription}" Foreground="#BBBBBB" FontSize="11" />
                                                                <TextBlock Text="{Binding DistanceFromArrivalLs}" Foreground="#999999" FontSize="11" />
                                                                <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasBiologicalSignals}">
                                                                    <TextBlock Text="Bio" Foreground="#8FBC8F" FontSize="11" />
                                                                    <TextBlock Text="{Binding BiologicalSignalsString}" Foreground="#8FBC8F" FontSize="11" />
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasGeologicalSignals}">
                                                                    <TextBlock Text="Geo" Foreground="#CD9B1D" FontSize="11" />
                                                                    <TextBlock Text="{Binding GeologicalSignalsString}" Foreground="#CD9B1D" FontSize="11" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="No bodies scanned yet. Use the Full Spectrum Scanner to discover bodies."
                               Foreground="#888888"
                               Margin="8"
                               IsVisible="{Binding CurrentSystemTree, Converter={StaticResource CountToBool}, ConverterParameter=empty}" />

                    <!-- Resize handle -->
                    <GridSplitter Grid.Column="1"
                                  ResizeDirection="Columns"
                                  Background="Transparent"
                                  Cursor="SizeWestEast"
                                  Width="4"
                                  Margin="0,0,0,0" />

                    <!-- Detail panel -->
                    <Border Grid.Column="2" BorderBrush="#404040" BorderThickness="1" CornerRadius="4" Margin="4,0,0,0">
                        <ScrollViewer>
                            <StackPanel Spacing="8" Margin="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding SelectedBody.FullName}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedBody.BodyDescription}"
                                               FontSize="13"
                                               Foreground="#BBBBBB"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Temp" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.SurfaceTemp}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Pressure" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.SurfacePressure}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Gravity" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.Gravity}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Radius" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.Radius}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Orbital" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.OrbitalPeriod}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Rotation" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.RotationPeriod}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Tidal Lock" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.TidalLock}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Terraform" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.TerraformStatus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Landable" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.Landable}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Arrival" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.DistanceFromArrivalLs}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Discovered" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.WasDiscoveredString}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Mapped" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.WasMappedString}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Body Value" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.DataValueString}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Bio / Geo" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.BiologicalSignalsString}" />
                                        <TextBlock Text="/" />
                                        <TextBlock Text="{Binding SelectedBody.GeologicalSignalsString}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Discovery / Mapped" Foreground="#999999" />
                                        <TextBlock Text="{Binding SelectedBody.FssValue}" />
                                        <TextBlock Text="/" />
                                        <TextBlock Text="{Binding SelectedBody.MappedValue}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Exobiology species for this body -->
                                <StackPanel Spacing="4" IsVisible="{Binding SelectedBody.HasBiologicalSignals}">
                                    <TextBlock Text="Exobiology" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedBody.OrganicValues}"
                                               FontSize="12"
                                               Foreground="#8FBC8F"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding SelectedBody.HasGeologicalSignals}">
                                    <TextBlock Text="Geology" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Signals" Foreground="#999999" FontSize="12" />
                                            <TextBlock Text="{Binding SelectedBody.GeologicalSignalsString}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Type" Foreground="#999999" FontSize="12" />
                                            <TextBlock Text="{Binding SelectedBody.GeologicalTypeDescription}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding SelectedBody.HasRings}">
                                    <TextBlock Text="Rings" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding SelectedBody.RingsView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RingClass}" Foreground="#AAAAAA" />
                                                    <TextBlock Grid.Column="2" Text="{Binding MassMT}" Foreground="#AAAAAA" Margin="12,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding SelectedBody.HasMaterials}">
                                    <TextBlock Text="Materials" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding SelectedBody.Materials}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Percent, StringFormat={}{0:0.0}%}" Foreground="#AAAAAA" Margin="12,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Empty state while the parser store is not live. -->
            <StackPanel IsVisible="{Binding CurrentState, Converter={StaticResource StateVisible}, ConverterParameter={x:Static models:CartoViewState.None}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="No commander loaded"
                           FontSize="18"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select a commander or journal folder from Settings to begin."
                           FontSize="13"
                           Foreground="#888888"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#323232" Padding="0,4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                    <TextBlock Text="Systems In Route : " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Route.Count, StringFormat=N0}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                    <TextBlock Text="Estimated Carto Value : " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CartoValue}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                    <TextBlock Text="Estimated Exo Value : " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ExoValue}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
