<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ODExplorer.ViewModels.ViewVMs"
             xmlns:modelvms="using:ODExplorer.ViewModels.ModelVMs"
             x:Class="ODExplorer.UI.Avalonia.Views.PopOutOverlays.SystemBodiesOverlayView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Text="{Binding CurrentSystem.Name, StringFormat='System Bodies — {0}'}"
                   FontWeight="SemiBold"
                   Margin="4,0,4,6" />
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding CurrentSystem.Bodies}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding BodyID}" Width="50" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Class" Binding="{Binding BodyDescription}" Width="*" />
                <DataGridTextColumn Header="Dist (ls)" Binding="{Binding DistanceFromArrivalLs}" Width="Auto" />
                <DataGridTextColumn Header="Mapped" Binding="{Binding MappedValue}" Width="Auto" />
                <DataGridTextColumn Header="FSS" Binding="{Binding FssValue}" Width="Auto" />
                <DataGridTextColumn Header="Scan" Binding="{Binding ScanStage}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
